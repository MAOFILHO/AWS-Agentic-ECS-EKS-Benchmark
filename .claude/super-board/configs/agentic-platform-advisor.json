{
  "version": 1,
  "description": "ECS vs EKS agent benchmark build board",
  "project": {
    "owner": "MAOFILHO",
    "title": "AWS-Agentic-ECS-EKS-Benchmark board",
    "number": 2
  },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "codex": {
    "model": null
  },
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/MAOFILHO/agentic-platform-advisor"
  },
  "base_branch": "main",
  "timezone": "America/Toronto",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 400,
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": [
      "supabase/migrations/**",
      "prisma/migrations/**",
      "drizzle/**",
      "**/migrations/*.sql",
      "db/migrate/**",
      "alembic/versions/**"
    ],
    "allowed_envs": [
      "test",
      "staging"
    ],
    "target_env": "staging",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": [
    "uv run --locked ruff check",
    "uv run --locked pytest"
  ],
  "max_workers": 0,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "collect": {
    "sources": [
      "github"
    ],
    "window_days": 14,
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "MAOFILHO"
  }
}
